import src.pisos.*
import src.ascensor.*
import src.items.*
import src.protagonista.*
import src.personajes.*

describe "Tests de Ascensor Dimensional - Grupo 03" {

  test "El protagonista empieza con manos vacías y sin acompañante" {
    assert.equals([manosVacias, manosVacias], protagonista.inventario())
    assert.equals(sinAcompaniante, protagonista.acompaniante())
  }

  test "El protagonista puede agarrar un objeto y tenerlo en su inventario" {
    protagonista.tomarItem(libroAntiguo)
    assert.that(protagonista.tiene(libroAntiguo))
  }

  test "Al soltar el ítem, vuelve a tener manos vacías" {
    protagonista.tomarItem(libroAntiguo)
    protagonista.quitarItem(libroAntiguo)
    assert.equals(manosVacias, protagonista.inventario().get(0))
  }

  test "viajar al piso 5" {
    ascensor.pisoActual(5)
    assert.equals(5, ascensor.pisoActual())
  }
}

describe "Tests del Ascensor" {
  test "El ascensor arranca en el piso 6 (Oficina)" {
    assert.equals(piso6_Oficina, ascensor.pisoActual())
    assert.equals(6, ascensor.pisoActual().numero())
  }
  test "El ascensor puede viajar a otro piso" {
    ascensor.pisoActual(piso1_Biblioteca)
    assert.equals(piso1_Biblioteca, ascensor.pisoActual())
    assert.equals(1, ascensor.pisoActual().numero())
  }
}
